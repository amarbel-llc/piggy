# pivy is vendored inside piggy. Its C package is built by the PARENT
# piggy flake as a nested derivation (nix/pivy.nix, src = ./vendor/pivy);
# run `nix build .#pivy` from the piggy repo root. vendor/pivy no longer
# carries its own flake — see piggy #124 (the duplicate amarbel-llc/nixpkgs
# input declaration was collapsed into the single parent flake).
#
# The recipes below are the standalone Rust dev-loop only — plain cargo,
# no flake needed. The vendored Rust pivy-agent (rust/) and the Go
# conformance binary (go/) are not wired into the parent flake (nothing in
# piggy consumes them); build/test them here via cargo, or the C package
# via `nix build .#pivy` at the piggy root.

default: build-rust test-rust

build-rust:
  cd rust && cargo build

build-rust-release:
  cd rust && cargo build --release

test-rust:
  cd rust && cargo test

test-rust-verbose:
  cd rust && cargo test -- --nocapture

fmt:
  cd rust && cargo fmt

clippy:
  cd rust && cargo clippy -- -D warnings

check:
  cd rust && cargo check

clean:
  cd rust && cargo clean
